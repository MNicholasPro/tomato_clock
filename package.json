{
  "name": "tomato-clock",
  "version": "1.0.1",
  "description": "专业番茄时钟 - macOS 状态栏应用",
  "author": "TomatoClock",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.tomato-clock.app",
    "productName": "TomatoClock",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSUserNotificationAlertStyle": "alert",
        "NSRequiresIPhoneOS": false,
        "NSHumanReadableCopyright": "© 2024 TomatoClock. All rights reserved.",
        "NSUserNotificationUsageDescription": "番茄钟需要发送通知来提醒您工作和休息时间",
        "NSNotificationsUsageDescription": "番茄钟需要发送通知来提醒您工作和休息时间"
      }
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "boolean": "^3.2.0",
    "electron": "^42.0.1",
    "glob": "^13.0.6",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
  }
}